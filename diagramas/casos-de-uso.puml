@startuml
left to right direction

actor "Estudiante" as estudiante
actor "Administrador" as administrador
actor "Sistema Universidad" as sistema_universidad

rectangle "Sistema de Gestión Académica e\nInscripción Interactiva" {
    usecase "Confirmar datos para el\nsimulador" as UC1
    usecase "Previsualizar datos\ninterpretados" as UC2
    usecase "Validar datos parseados" as UC3
    usecase "Confirmar datos para el\nsimulador" as UC4
}

estudiante -- UC1
estudiante -- UC4

administrador -- UC1
administrador -- UC4

sistema_universidad -- UC4

UC1 ..> UC2 : <<include>>
UC4 ..> UC3 : <<include>>
@enduml
