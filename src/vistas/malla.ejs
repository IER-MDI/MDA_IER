<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SGAI — Malla interactiva</title>
    <style>
      :root {
        color-scheme: light;
        font-family: system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
      }
      body {
        margin: 0;
        background: #f4f6f8;
        color: #1f2933;
      }
      header {
        background: #1f3a5f;
        color: #ffffff;
        padding: 1rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
      }
      header h1 {
        font-size: 1.15rem;
        margin: 0;
      }
      header .datos {
        font-size: 0.85rem;
        opacity: 0.9;
      }
      .navegacion {
        display: flex;
        gap: 0.8rem;
      }
      .navegacion a {
        color: #ffffff;
        font-size: 0.85rem;
        text-decoration: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.5);
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.25rem;
        display: grid;
        gap: 1.25rem;
      }
      .tarjeta {
        background: #ffffff;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        padding: 1rem;
      }
      .tarjeta h2 {
        margin-top: 0;
        font-size: 1rem;
      }
      .tarjeta h3 {
        margin-bottom: 0.25rem;
        font-size: 0.95rem;
      }
      .leyenda {
        color: #52606d;
        font-size: 0.85rem;
      }
      .asignaturas {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 0.75rem;
      }
      .asignatura {
        border: 2px solid #c3ccd6;
        border-radius: 8px;
        padding: 0.6rem 0.75rem;
        transition: opacity 0.15s ease, box-shadow 0.15s ease;
      }
      .asignatura a {
        color: inherit;
        text-decoration: none;
        display: block;
      }
      .asignatura .codigo {
        display: block;
        font-weight: 600;
      }
      .asignatura .nombre {
        display: block;
        font-size: 0.85rem;
      }
      .asignatura .creditos {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.75rem;
        color: #52606d;
      }
      .asignatura .estado {
        display: inline-block;
        margin-top: 0.35rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .asignatura .etiqueta-resultado {
        display: inline-block;
        margin-top: 0.3rem;
        margin-left: 0.35rem;
        font-size: 0.72rem;
        background: #ffffff;
        border: 1px solid currentColor;
        border-radius: 999px;
        padding: 0 0.45rem;
      }
      .estado-aprobada {
        background: #e3f9e5;
        border-color: #7fd18b;
      }
      .estado-disponible {
        background: #e6f0fd;
        border-color: #8ab4e2;
      }
      .estado-bloqueada {
        background: #eef1f4;
        border-color: #c3ccd6;
      }
      .asignatura.relacionada {
        box-shadow: inset 0 0 0 2px #1f3a5f;
      }
      .asignatura.seleccionada {
        box-shadow: 0 0 0 3px #1f3a5f;
      }
      .asignatura.atenuada {
        opacity: 0.35;
      }
      .resumen p {
        margin: 0.3rem 0;
      }
      .vacio {
        color: #616e7c;
        font-style: italic;
      }
      button {
        cursor: pointer;
        border: 1px solid #1f3a5f;
        background: #ffffff;
        color: #1f3a5f;
        border-radius: 4px;
        padding: 0.2rem 0.5rem;
      }
      button:hover {
        background: #e0edff;
      }
      form.en-linea {
        display: inline;
      }
    </style>
  </head>
  <body>
    <%- include("parciales/cabecera", { rol, rolEtiqueta, estudiante }) %>
    <main>
      <section class="tarjeta resumen">
        <h2>Malla de <%= carrera.nombre %></h2>
        <p class="leyenda">
          Colores: <strong>aprobada</strong> (verde), <strong>disponible</strong> (azul) y
          <strong>bloqueada</strong> (gris). La etiqueta «En curso» o «Reprobada» no cambia el color.
        </p>
        <% if (seleccionada) { %>
          <h3>
            <%= seleccionada.codigo %> · <%= seleccionada.nombre %>
            (<%= seleccionada.etiquetaEstado %>)
          </h3>
          <p>
            <strong>Prerrequisitos:</strong>
            <% if (cadena.prerrequisitos.length === 0) { %>
              Sin prerrequisitos
            <% } else { %>
              <%= cadena.prerrequisitos.map((asignatura) => asignatura.codigo + " " + asignatura.nombre).join(", ") %>
            <% } %>
          </p>
          <p>
            <strong>Dependientes:</strong>
            <% if (cadena.dependientes.length === 0) { %>
              Sin asignaturas dependientes
            <% } else { %>
              <%= cadena.dependientes.map((asignatura) => asignatura.codigo + " " + asignatura.nombre).join(", ") %>
            <% } %>
          </p>
        <% } else { %>
          <p class="vacio">Selecciona una asignatura para ver su cadena de prerrequisitos y dependientes.</p>
        <% } %>
      </section>

      <% for (const grupo of semestres) { %>
        <section class="tarjeta semestre">
          <h2>Semestre <%= grupo.semestre %></h2>
          <div class="asignaturas">
            <% for (const asignatura of grupo.asignaturas) { %>
              <article
                class="asignatura estado-<%= asignatura.estado %> <%= asignatura.clase %>"
                data-codigo="<%= asignatura.codigo %>"
                data-estado="<%= asignatura.estado %>"
              >
                <a href="/malla?asignatura=<%= asignatura.codigo %>">
                  <span class="codigo"><%= asignatura.codigo %></span>
                  <span class="nombre"><%= asignatura.nombre %></span>
                  <span class="estado"><%= asignatura.etiquetaEstado %></span>
                  <% if (asignatura.etiquetaResultado) { %>
                    <span class="etiqueta-resultado"><%= asignatura.etiquetaResultado %></span>
                  <% } %>
                  <span class="creditos"><%= asignatura.creditos %> créditos</span>
                </a>
              </article>
            <% } %>
          </div>
        </section>
      <% } %>
    </main>
  </body>
</html>
