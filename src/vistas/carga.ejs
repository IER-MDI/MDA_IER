<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SGAI — Carga de oferta académica</title>
    <style>
      :root {
        color-scheme: light;
        font-family: system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
      }
      body {
        margin: 0;
        background: #f4f6f8;
        color: #1f2933;
      }
      header {
        background: #1f3a5f;
        color: #ffffff;
        padding: 1rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
      }
      header h1 {
        font-size: 1.15rem;
        margin: 0;
      }
      header .datos {
        font-size: 0.85rem;
        opacity: 0.9;
      }
      .navegacion {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
      }
      .navegacion a {
        color: #ffffff;
        font-size: 0.85rem;
        text-decoration: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.5);
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.25rem;
        display: grid;
        gap: 1.25rem;
      }
      .tarjeta {
        background: #ffffff;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        padding: 1rem;
      }
      .tarjeta h2 {
        margin-top: 0;
        font-size: 1rem;
      }
      .mensaje {
        padding: 0.65rem 0.9rem;
        border-radius: 6px;
        margin: 0;
      }
      .mensaje.ok {
        background: #e3f9e5;
        border: 1px solid #7fd18b;
      }
      .mensaje.error {
        background: #fde8e8;
        border: 1px solid #e28a8a;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }
      th,
      td {
        border: 1px solid #d9e2ec;
        padding: 0.45rem;
        vertical-align: top;
        text-align: left;
      }
      th {
        background: #eef2f6;
      }
      button {
        cursor: pointer;
        border: 1px solid #1f3a5f;
        background: #ffffff;
        color: #1f3a5f;
        border-radius: 4px;
        padding: 0.3rem 0.6rem;
      }
      button:hover {
        background: #e0edff;
      }
      .en-linea {
        display: inline;
      }
      .zona {
        border: 2px dashed #9fb3c8;
        border-radius: 8px;
        padding: 1.25rem;
        text-align: center;
        color: #52606d;
        background: #f8fafc;
      }
      .zona.sobrevolar {
        background: #e0edff;
      }
      .acciones {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .vacio {
        color: #616e7c;
        font-style: italic;
      }
      .estado {
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <%- include("parciales/cabecera", { rol, rolEtiqueta, estudiante }) %>
    <main>
      <%- include("parciales/mensajes", { ok, error }) %>

      <section class="tarjeta">
        <h2>Cargar planilla de oferta académica</h2>
        <p>
          El sistema acepta archivos <strong>.xlsx</strong> o <strong>.csv</strong> publicados por la
          Universidad. Puedes
          <a href="/carga/ejemplo">descargar una planilla de ejemplo (2026-3)</a>.
        </p>
        <form method="post" action="/carga/archivo" enctype="multipart/form-data">
          <div class="zona" id="zona">
            <p>Arrastra aquí la planilla o selecciónala con el botón.</p>
            <input type="file" id="archivo" name="archivo" accept=".xlsx,.csv" required />
          </div>
          <p><button type="submit">Leer planilla</button></p>
        </form>
      </section>

      <% if (borrador) { %>
      <section class="tarjeta">
        <h2>Carga <span class="estado"><%= borrador.periodo %></span> · estado: <%= estado %></h2>
        <p>Período leído de la planilla: <strong><%= borrador.periodo %></strong>.</p>

        <form method="post" action="/carga/<%= id %>/mapeo">
          <table>
            <thead>
              <tr><th>Campo del sistema</th><th>Columna de la planilla</th></tr>
            </thead>
            <tbody>
              <% campos.forEach(function (campo) { %>
              <tr>
                <td><%= campo %></td>
                <td>
                  <select name="mapeo_<%= campo %>">
                    <option value="">— sin asignar —</option>
                    <% borrador.encabezados.forEach(function (encabezado) { %>
                    <option value="<%= encabezado %>" <%= borrador.mapeo[campo] === encabezado ? "selected" : "" %>><%= encabezado %></option>
                    <% }) %>
                  </select>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <p><button type="submit">Aplicar mapeo y validar</button></p>
        </form>
      </section>

      <section class="tarjeta">
        <h2>Secciones interpretadas</h2>
        <% if (borrador.filas.length === 0) { %>
        <p class="vacio">No hay secciones válidas en este momento.</p>
        <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Fila</th><th>Asignatura</th><th>Sección</th><th>Docente</th>
              <th>Créditos</th><th>Cupos</th><th>Semestre</th><th>Bloques horarios</th>
            </tr>
          </thead>
          <tbody>
            <% borrador.filas.forEach(function (fila) { %>
            <tr>
              <td><%= fila.numeroFila %></td>
              <td><%= fila.codigo %> — <%= fila.nombre %></td>
              <td><%= fila.numero %></td>
              <td><%= fila.docente %></td>
              <td><%= fila.creditos %></td>
              <td><%= fila.cupos %></td>
              <td><%= fila.semestreSugerido %></td>
              <td><%= fila.bloques.map(function (bloque) { return bloque.dia + " " + bloque.horaInicio + "–" + bloque.horaFin; }).join(" · ") %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </section>

      <% if (borrador.errores.length > 0) { %>
      <section class="tarjeta">
        <h2>Filas sin incorporar</h2>
        <ul>
          <% borrador.errores.forEach(function (errorFila) { %>
          <li>Fila <%= errorFila.numeroFila %> — <%= errorFila.motivo %></li>
          <% }) %>
        </ul>
        <form method="post" action="/carga/<%= id %>/excluir" class="en-linea">
          <button type="submit">Confirmar exclusión y continuar</button>
        </form>
      </section>
      <% } %>

      <section class="tarjeta">
        <div class="acciones">
          <% if (estado === "Estructurada") { %>
          <form method="post" action="/carga/<%= id %>/confirmar" class="en-linea">
            <button type="submit">Confirmar y publicar oferta</button>
          </form>
          <% } %>
          <form method="post" action="/carga/<%= id %>/cancelar" class="en-linea">
            <button type="submit">Cancelar carga</button>
          </form>
          <a href="/planificador">Ir al planificador</a>
        </div>
      </section>
      <% } %>
    </main>
    <script>
      const zona = document.getElementById("zona");
      const entrada = document.getElementById("archivo");
      if (zona && entrada) {
        zona.addEventListener("dragover", function (evento) {
          evento.preventDefault();
          zona.classList.add("sobrevolar");
        });
        zona.addEventListener("dragleave", function () {
          zona.classList.remove("sobrevolar");
        });
        zona.addEventListener("drop", function (evento) {
          evento.preventDefault();
          zona.classList.remove("sobrevolar");
          if (evento.dataTransfer && evento.dataTransfer.files.length > 0) {
            entrada.files = evento.dataTransfer.files;
          }
        });
      }
    </script>
  </body>
</html>
